# Copy this to `web/backend/.env.prod` on the VPS and fill in real values.
#   cp .env.prod.example .env.prod
#   nano .env.prod
#
# The POSTGRES_PASSWORD here must match the one in `web/.env` (compose-level).
#
# This setup assumes: backend + Postgres on the VPS (behind Caddy for HTTPS
# at api.tenderxnepal.com), frontend + admin deployed separately on Vercel.

DATABASE_URL=postgresql+psycopg://tenderx:change-me-to-a-strong-random-password@db:5432/tenderx

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-real-random-secret

# Every origin allowed to call this API. Replace with your actual Vercel
# deployment URLs once you have them (both the production URL and, if you
# want local testing against the live API, http://localhost:3000/3001 too).
CORS_ORIGINS=["https://your-frontend.vercel.app","https://your-admin.vercel.app"]

STORAGE_ROOT=/data

# Used inside verification/password-reset email links — must match wherever
# the client app is actually reachable (your Vercel URL, or tenderxnepal.com
# once that's pointed at the frontend deployment).
FRONTEND_BASE_URL=https://your-frontend.vercel.app

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=civoraxt@gmail.com
SMTP_PASSWORD=your-new-16-char-app-password-no-spaces
SMTP_FROM=TenderX Nepal <civoraxt@gmail.com>
SMTP_USE_TLS=true
